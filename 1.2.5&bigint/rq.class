import java.util.Random;

public class rq extends li {
   public rq() {
   }

   public boolean generate(xd par1World, Random par2Random, long par3, int par4, long par5) {
      for(int i = 0; i < 64; ++i) {
         long j = par3 + (long)par2Random.nextInt(8) - (long)par2Random.nextInt(8);
         int k = par4 + par2Random.nextInt(4) - par2Random.nextInt(4);
         long l = par5 + (long)par2Random.nextInt(8) - (long)par2Random.nextInt(8);
         if (par1World.isAirBlock(j, k, l) && par1World.getBlockId(j, k - 1, l) == pb.bb.bO) {
            par1World.setBlockWithNotify(j, k, l, pb.ar.bO);
         }
      }

      return true;
   }
}
