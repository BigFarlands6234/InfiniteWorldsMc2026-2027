public class sj {
   public final long a;
   public final long b;

   public sj(long par1, long par2) {
      this.a = par1;
      this.b = par2;
   }

   public static long chunkXZ2Int(long par0, long par1) {
      return par0 & 4294967295L | (par1 & 4294967295L) << 32;
   }

   public int hashCode() {
      long l = chunkXZ2Int(this.a, this.b);
      int i = (int)l;
      int j = (int)(l >> 32);
      return i ^ j;
   }

   public boolean equals(Object par1Obj) {
      sj chunkcoordintpair = (sj)par1Obj;
      return chunkcoordintpair.a == this.a && chunkcoordintpair.b == this.b;
   }

   public long getCenterXPos() {
      return (this.a << 4) + 8L;
   }

   public long getCenterZPos() {
      return (this.b << 4) + 8L;
   }

   public qo a(int par1) {
      return new qo(this.getCenterXPos(), par1, this.getCenterZPos());
   }

