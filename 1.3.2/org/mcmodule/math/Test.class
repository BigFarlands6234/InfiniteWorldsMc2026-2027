package org.mcmodule.math;

import java.util.Arrays;
import java.util.Random;

public class Test {
   private static final int TEST_COUNT = 10000000;
   private static final int MAX_STRINGINT_LENGTH = 30;
   private static final int MIN_STRINGINT_LENGTH = 10;
   private static final Random rand = new Random(0L);
   private static final char[] chars = "12345687890".toCharArray();
   private static final char[] charsWithoutZero;

   public Test() {
   }

   public static void main(String[] args) {
      doBigIntegerTest();
   }

   private static void doBigIntegerTest() {
      testCreate();
   }

   private static void testCreate() {
      long javaBigIntegerTime = 0L;
      long bigIntegerTime = 0L;
      long time = 0L;

      for(int i = 0; i < 10000000; ++i) {
         BigInteger bigInteger = (BigInteger)BigInteger.allocator.allocate();
         bigInteger.init(randomStringInteger());
         bigInteger.recycle();
      }

      for(int i = 0; i < 10000000; ++i) {
         String num = randomStringInteger();
         time = System.nanoTime();
         new BigInteger(num);
         javaBigIntegerTime += System.nanoTime() - time;
         time = System.nanoTime();
         BigInteger bigInteger = (BigInteger)BigInteger.allocator.allocate();
         bigInteger.init(num);
         bigIntegerTime += System.nanoTime() - time;
         bigInteger.recycle();
      }

      long diff = javaBigIntegerTime - bigIntegerTime;
      double average = (double)diff / (double)1.0E7F;
      System.out.println(String.format("result:\n\tJava:    %dns\n\tCusmote: %dns\n\t(speed: %f%%)\n\t%fns %ser", javaBigIntegerTime, bigIntegerTime, (double)javaBigIntegerTime / (double)bigIntegerTime * (double)100.0F, Math.abs(average), average < (double)0.0F ? "slow" : "fast"));
      System.gc();
   }

   private static String randomStringInteger() {
      StringBuilder sb = new StringBuilder();
      int count = 10 + rand.nextInt(21) - 1;
      sb.append(charsWithoutZero[rand.nextInt(charsWithoutZero.length)]);

      for(int i = 0; i < count; ++i) {
         sb.append(chars[rand.nextInt(chars.length)]);
      }

      return sb.toString();
   }

   static {
      charsWithoutZero = Arrays.copyOf(chars, chars.length - 1);
   }
}
