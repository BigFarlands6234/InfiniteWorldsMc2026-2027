package org.mcmodule.util;

public interface Recycleable {
   void recycle();

   ObjectAllocator<?> getAllocator();

   void setAllocator(ObjectAllocator<?> var1);

   default void setDontRecycle() {
      this.setAllocator((ObjectAllocator)null);
   }

   void markRecycled(ObjectAllocator<?> var1);

   void onRecycle();
}
