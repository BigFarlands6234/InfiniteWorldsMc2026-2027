package bigfarlands6234.farlands.mixin;

import net.minecraft.class_1297;
import net.minecraft.class_3532;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Redirect;

@Mixin({class_1297.class})
public class MixinEntity {
   public MixinEntity() {
   }

   @Redirect(
      method = {"updatePosition"},
      at = @At(
   target = "Lnet/minecraft/util/math/MathHelper;clamp(DDD)D",
   value = "INVOKE"
)
   )
   private double redirectClamp(double value, double min, double max) {
      return class_3532.method_15350(value, (double)Integer.MIN_VALUE, (double)Integer.MAX_VALUE);
   }
}
